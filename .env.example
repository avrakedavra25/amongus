# =================================================================
# Among Us Campus Event Landing Page - Environment Variables Template
# Copy this file to .env and fill in your Supabase project credentials.
#
# NOTE: VITE_ variables are embedded into client bundles and are public!
# NEVER put secret service_role keys or private backend credentials here.
# =================================================================

# Optional Supabase integration for persistent registration storage:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

